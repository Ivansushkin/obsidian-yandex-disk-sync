{
	"name": "yandex-disk-sync",
	"version": "2.0.0",
	"description": "Sync Obsidian vault with Yandex Disk",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check:bundle": "node scripts/check-bundle.mjs",
		"test": "node test.config.mjs",
		"validate:release": "node scripts/validate-release.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings 0"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"obsidian": "1.13.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {
		"@noble/ciphers": "2.2.0",
		"jszip": "3.10.1"
	}
}
